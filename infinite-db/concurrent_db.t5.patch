+    /// T5 effect boundary for hyperedge writes.
+    ///
+    /// Must run *before* a revision is stamped: validating afterwards leaves a
+    /// stamped-but-never-enqueued revision, and `sync()` then waits forever for a
+    /// watermark that cannot advance. `Hyperedge::storage_point` packs a u64 id
+    /// into two u32 coordinates, so a space with `bits_per_dim < 32` cannot hold
+    /// arbitrary edge ids; without this check that reached `hilbert::encode` and
+    /// panicked inside a pure function.
+    fn validate_edge_storage_point(
+        &self,
+        space: SpaceId,
+        id: crate::infinitedb_core::hyperedge::HyperedgeId,
+    ) -> Result<(), EngineError> {
+        let spaces = self.spaces.read();
+        let config = spaces.get(space).ok_or(EngineError::SpaceNotFound(space))?;
+        crate::engine::write_validate::validate_point_bounds(
+            config,
+            &crate::infinitedb_core::hyperedge::Hyperedge::storage_point(id),
+        )
+    }
+
